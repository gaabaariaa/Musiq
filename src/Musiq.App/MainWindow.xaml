<Window x:Class="Musiq.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Musiq" Width="1440" Height="900" MinWidth="1050" MinHeight="680"
 Background="#0D0E12" Foreground="#F5F5F7" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <SolidColorBrush x:Key="Panel" Color="#15161B"/>
  <SolidColorBrush x:Key="Soft" Color="#1C1D23"/>
  <SolidColorBrush x:Key="Hover" Color="#26272E"/>
  <SolidColorBrush x:Key="Text2" Color="#9B9DA7"/>
  <SolidColorBrush x:Key="Muted" Color="#696B75"/>
  <SolidColorBrush x:Key="Gold" Color="#D7B46A"/>
  <SolidColorBrush x:Key="GoldSoft" Color="#2B2417"/>
  <SolidColorBrush x:Key="Line" Color="#272830"/>
  <Style x:Key="Nav" TargetType="Button">
   <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource Text2}"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
   <Setter Property="Padding" Value="13,10"/><Setter Property="Margin" Value="0,2"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border Background="{TemplateBinding Background}" CornerRadius="9"><ContentPresenter Margin="{TemplateBinding Padding}"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource Hover}"/><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Icon" TargetType="Button">
   <Setter Property="Width" Value="38"/><Setter Property="Height" Value="38"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="Foreground" Value="{StaticResource Text2}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="19"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource Hover}"/><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Chip" TargetType="Button">
   <Setter Property="Background" Value="{StaticResource Soft}"/><Setter Property="Foreground" Value="{StaticResource Text2}"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="14,7"/><Setter Property="Margin" Value="0,0,7,0"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="16"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource Hover}"/><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="RoundPlay" TargetType="Button">
   <Setter Property="Width" Value="40"/><Setter Property="Height" Value="40"/><Setter Property="Background" Value="{StaticResource Gold}"/><Setter Property="Foreground" Value="#15120C"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="20"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#E3C27A"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="90"/></Grid.RowDefinitions>
  <Grid.ColumnDefinitions><ColumnDefinition Width="225"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

  <Border Grid.Row="0" Grid.Column="0" Background="#111217" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="18,25">
   <DockPanel>
    <StackPanel>
     <TextBlock Text="MUSIQ" FontSize="24" FontWeight="Bold" Margin="10,0,0,32"/>
     <TextBlock Text="LIBRARY" FontSize="10" Foreground="{StaticResource Muted}" Margin="11,0,0,8"/>
     <Button Style="{StaticResource Nav}" Background="{StaticResource GoldSoft}" Foreground="{StaticResource Gold}">
      <StackPanel Orientation="Horizontal"><TextBlock Text="⌂" Width="30" FontSize="18"/><TextBlock Text="Home"/></StackPanel>
     </Button>
     <Button Style="{StaticResource Nav}"><StackPanel Orientation="Horizontal"><TextBlock Text="♫" Width="30" FontSize="17"/><TextBlock Text="Songs"/></StackPanel></Button>
     <Button Style="{StaticResource Nav}"><StackPanel Orientation="Horizontal"><TextBlock Text="◷" Width="30" FontSize="17"/><TextBlock Text="Recently Played"/></StackPanel></Button>
     <Button Style="{StaticResource Nav}"><StackPanel Orientation="Horizontal"><TextBlock Text="★" Width="30" FontSize="17"/><TextBlock Text="Favorites"/></StackPanel></Button>
     <TextBlock Text="PLAYLISTS" FontSize="10" Foreground="{StaticResource Muted}" Margin="11,28,0,8"/>
     <Button Style="{StaticResource Nav}"><StackPanel Orientation="Horizontal"><TextBlock Text="＋" Width="30" FontSize="17"/><TextBlock Text="New Playlist"/></StackPanel></Button>
     <Button Style="{StaticResource Nav}"><StackPanel Orientation="Horizontal"><TextBlock Text="▣" Width="30"/><TextBlock Text="Favorites Mix"/></StackPanel></Button>
     <Button Style="{StaticResource Nav}"><StackPanel Orientation="Horizontal"><TextBlock Text="▣" Width="30"/><TextBlock Text="Road Trip"/></StackPanel></Button>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom">
     <Separator Background="{StaticResource Line}" Margin="10,0,10,10"/>
     <Button Style="{StaticResource Nav}"><StackPanel Orientation="Horizontal"><TextBlock Text="⚙" Width="30"/><TextBlock Text="Settings"/></StackPanel></Button>
    </StackPanel>
   </DockPanel>
  </Border>

  <Grid Grid.Row="0" Grid.Column="1" Margin="32,25,32,20">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid Grid.Row="0" Margin="0,0,0,20">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="360"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel>
     <TextBlock Text="Good evening" FontSize="28" FontWeight="SemiBold"/>
     <TextBlock Text="Your music, your way." Foreground="{StaticResource Text2}" FontSize="13" Margin="0,4,0,0"/>
    </StackPanel>
    <Border Grid.Column="1" Height="42" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="21" Margin="20,0">
     <Grid><TextBlock Text="⌕" FontSize="20" Foreground="{StaticResource Muted}" Margin="15,0,0,0" VerticalAlignment="Center"/><TextBox Margin="45,0,15,0" Background="Transparent" BorderThickness="0" Foreground="White" VerticalContentAlignment="Center" Text="Search your library"/></Grid>
    </Border>
    <Button Grid.Column="2" Style="{StaticResource Icon}" Content="◉"/>
   </Grid>

   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
    <StackPanel>
     <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
      <Button Style="{StaticResource Chip}" Background="{StaticResource GoldSoft}" Foreground="{StaticResource Gold}" Content="All music"/>
      <Button Style="{StaticResource Chip}" Content="Albums"/>
      <Button Style="{StaticResource Chip}" Content="Artists"/>
      <Button Style="{StaticResource Chip}" Content="Genres"/>
      <Button Style="{StaticResource Chip}" Content="Playlists"/>
     </StackPanel>

     <Border Background="{StaticResource Panel}" CornerRadius="18" Padding="22" Margin="0,0,0,22">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Border Width="64" Height="64" CornerRadius="12" Background="{StaticResource GoldSoft}"><TextBlock Text="♫" FontSize="30" Foreground="{StaticResource Gold}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
       <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"><TextBlock Text="Songs" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="1,284 tracks in your library" Foreground="{StaticResource Text2}" FontSize="12" Margin="0,4,0,0"/></StackPanel>
       <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Sort: Recently added" Background="{StaticResource Soft}" Foreground="{StaticResource Text2}" BorderThickness="0" Padding="13,8" Margin="0,0,8,0"/><Button Content="⋮" Width="38" Height="38" Background="{StaticResource Soft}" Foreground="{StaticResource Text2}" BorderThickness="0"/></StackPanel>
      </Grid>
     </Border>
     <Border Background="{StaticResource Panel}" CornerRadius="14" Padding="10" Margin="0,0,0,24">
      <StackPanel>
       <Grid Height="38" Margin="7,0"><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="150"/><ColumnDefinition Width="70"/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions><TextBlock Text="#" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="TITLE" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="ALBUM" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="ARTIST" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center"/><TextBlock Grid.Column="4" Text="TIME" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center"/><TextBlock Grid.Column="5" Text="" /></Grid>
       <Separator Background="{StaticResource Line}"/>
       <Border Background="{StaticResource GoldSoft}" CornerRadius="8" Padding="7,3" Margin="0,2"><Grid Height="52"><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="150"/><ColumnDefinition Width="70"/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions><TextBlock Text="01" Foreground="{StaticResource Gold}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Border Width="34" Height="34" CornerRadius="6" Background="#29252B"><TextBlock Text="♫" Foreground="{StaticResource Gold}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="10,0,0,0"><TextBlock Text="Midnight Drive" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="Neon Avenue" Foreground="{StaticResource Text2}" FontSize="10"/></StackPanel></StackPanel><TextBlock Grid.Column="2" Text="Night City" Foreground="{StaticResource Text2}" FontSize="11" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="Neon Avenue" Foreground="{StaticResource Text2}" FontSize="11" VerticalAlignment="Center"/><TextBlock Grid.Column="4" Text="4:18" Foreground="{StaticResource Text2}" FontSize="11" VerticalAlignment="Center"/><Button Grid.Column="5" Content="⋮" Foreground="{StaticResource Text2}" Background="Transparent" BorderThickness="0" Width="34" Height="34"/></Grid></Border>
       <Border Background="Transparent" CornerRadius="8" Padding="7,3" Margin="0,2"><Grid Height="52"><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="150"/><ColumnDefinition Width="70"/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions><TextBlock Text="02" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Border Width="34" Height="34" CornerRadius="6" Background="#24272B"><TextBlock Text="♫" Foreground="{StaticResource Gold}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="10,0,0,0"><TextBlock Text="After Hours" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="The Satellites" Foreground="{StaticResource Text2}" FontSize="10"/></StackPanel></StackPanel><TextBlock Grid.Column="2" Text="After Hours" Foreground="{StaticResource Text2}" FontSize="11" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="The Satellites" Foreground="{StaticResource Text2}" FontSize="11" VerticalAlignment="Center"/><TextBlock Grid.Column="4" Text="3:51" Foreground="{StaticResource Text2}" FontSize="11" VerticalAlignment="Center"/><Button Grid.Column="5" Content="⋮" Foreground="{StaticResource Text2}" Background="Transparent" BorderThickness="0" Width="34" Height="34"/></Grid></Border>
       <Border Background="Transparent" CornerRadius="8" Padding="7,3" Margin="0,2"><Grid Height="52"><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="150"/><ColumnDefinition Width="70"/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions><TextBlock Text="03" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Border Width="34" Height="34" CornerRadius="6" Background="#2B2925"><TextBlock Text="♫" Foreground="{StaticResource Gold}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="10,0,0,0"><TextBlock Text="Golden Lines" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="Mira Stone" Foreground="{StaticResource Text2}" FontSize="10"/></StackPanel></StackPanel><TextBlock Grid.Column="2" Text="Golden Lines" Foreground="{StaticResource Text2}" FontSize="11" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="Mira Stone" Foreground="{StaticResource Text2}" FontSize="11" VerticalAlignment="Center"/><TextBlock Grid.Column="4" Text="4:06" Foreground="{StaticResource Text2}" FontSize="11" VerticalAlignment="Center"/><Button Grid.Column="5" Content="⋮" Foreground="{StaticResource Text2}" Background="Transparent" BorderThickness="0" Width="34" Height="34"/></Grid></Border>
       <Border Background="Transparent" CornerRadius="8" Padding="7,3" Margin="0,2"><Grid Height="52"><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="150"/><ColumnDefinition Width="70"/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions><TextBlock Text="04" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Border Width="34" Height="34" CornerRadius="6" Background="#25272D"><TextBlock Text="♫" Foreground="{StaticResource Gold}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="10,0,0,0"><TextBlock Text="Silver Rain" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="Mira Stone" Foreground="{StaticResource Text2}" FontSize="10"/></StackPanel></StackPanel><TextBlock Grid.Column="2" Text="Silver Rain" Foreground="{StaticResource Text2}" FontSize="11" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="Mira Stone" Foreground="{StaticResource Text2}" FontSize="11" VerticalAlignment="Center"/><TextBlock Grid.Column="4" Text="3:42" Foreground="{StaticResource Text2}" FontSize="11" VerticalAlignment="Center"/><Button Grid.Column="5" Content="⋮" Foreground="{StaticResource Text2}" Background="Transparent" BorderThickness="0" Width="34" Height="34"/></Grid></Border>
       <Border Background="Transparent" CornerRadius="8" Padding="7,3" Margin="0,2"><Grid Height="52"><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="150"/><ColumnDefinition Width="70"/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions><TextBlock Text="05" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Border Width="34" Height="34" CornerRadius="6" Background="#29262C"><TextBlock Text="♫" Foreground="{StaticResource Gold}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="10,0,0,0"><TextBlock Text="Open Roads" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="Northbound" Foreground="{StaticResource Text2}" FontSize="10"/></StackPanel></StackPanel><TextBlock Grid.Column="2" Text="Open Roads" Foreground="{StaticResource Text2}" FontSize="11" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="Northbound" Foreground="{StaticResource Text2}" FontSize="11" VerticalAlignment="Center"/><TextBlock Grid.Column="4" Text="4:12" Foreground="{StaticResource Text2}" FontSize="11" VerticalAlignment="Center"/><Button Grid.Column="5" Content="⋮" Foreground="{StaticResource Text2}" Background="Transparent" BorderThickness="0" Width="34" Height="34"/></Grid></Border>
       <Border Background="Transparent" CornerRadius="8" Padding="7,3" Margin="0,2"><Grid Height="52"><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="150"/><ColumnDefinition Width="70"/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions><TextBlock Text="06" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Border Width="34" Height="34" CornerRadius="6" Background="#23252B"><TextBlock Text="♫" Foreground="{StaticResource Gold}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="10,0,0,0"><TextBlock Text="Blue Hour" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="Neon Avenue" Foreground="{StaticResource Text2}" FontSize="10"/></StackPanel></StackPanel><TextBlock Grid.Column="2" Text="Blue Hour" Foreground="{StaticResource Text2}" FontSize="11" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="Neon Avenue" Foreground="{StaticResource Text2}" FontSize="11" VerticalAlignment="Center"/><TextBlock Grid.Column="4" Text="3:58" Foreground="{StaticResource Text2}" FontSize="11" VerticalAlignment="Center"/><Button Grid.Column="5" Content="⋮" Foreground="{StaticResource Text2}" Background="Transparent" BorderThickness="0" Width="34" Height="34"/></Grid></Border>
      </StackPanel>
     </Border>

     <!-- Album & Artist browsing surface -->
     <Border Background="{StaticResource Panel}" CornerRadius="18" Padding="22" Margin="0,0,0,24">
      <StackPanel>
       <Grid Margin="0,0,0,18">
        <StackPanel><TextBlock Text="Albums" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Browse your collection by album" Foreground="{StaticResource Text2}" FontSize="11" Margin="0,4,0,0"/></StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
         <Border Background="{StaticResource GoldSoft}" CornerRadius="14" Padding="10,6" Margin="0,0,8,0"><TextBlock Text="128 albums" Foreground="{StaticResource Gold}" FontSize="10"/></Border>
         <Button Content="Recently added  ▾" Background="{StaticResource Soft}" Foreground="{StaticResource Text2}" BorderThickness="0" Padding="11,7"/>
        </StackPanel>
       </Grid>
       <UniformGrid Columns="4" Margin="0,0,0,28">
        <Border Background="{StaticResource GoldSoft}" CornerRadius="14" Padding="11" Margin="0,0,8,0" BorderBrush="{StaticResource Gold}" BorderThickness="1">
         <StackPanel>
          <Grid Height="150"><Border CornerRadius="11" Background="#29252B"><Grid><TextBlock Text="♫" FontSize="54" Foreground="{StaticResource Gold}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Border Background="#15161B" Opacity=".9" CornerRadius="8" Padding="7,4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"><TextBlock Text="12 TRACKS" FontSize="8" Foreground="{StaticResource Gold}" FontWeight="SemiBold"/></Border><Button Style="{StaticResource RoundPlay}" Content="▶" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8"/></Grid></Border></Grid>
          <TextBlock Text="Night City" FontSize="14" FontWeight="SemiBold" Margin="2,10,0,0"/><TextBlock Text="Neon Avenue" Foreground="{StaticResource Text2}" FontSize="11" Margin="2,3,0,0"/><TextBlock Text="12 songs · 2026" Foreground="{StaticResource Muted}" FontSize="10" Margin="2,6,0,0"/>
         </StackPanel>
        </Border>
        <Border Background="{StaticResource Panel}" CornerRadius="14" Padding="11" Margin="8,0" BorderBrush="{StaticResource Line}" BorderThickness="1">
         <StackPanel><Grid Height="150"><Border CornerRadius="11" Background="#24272B"><Grid><TextBlock Text="♫" FontSize="54" Foreground="{StaticResource Gold}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Button Style="{StaticResource RoundPlay}" Content="▶" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8"/></Grid></Border></Grid><TextBlock Text="After Hours" FontSize="14" FontWeight="SemiBold" Margin="2,10,0,0"/><TextBlock Text="The Satellites" Foreground="{StaticResource Text2}" FontSize="11" Margin="2,3,0,0"/><TextBlock Text="9 songs · 2026" Foreground="{StaticResource Muted}" FontSize="10" Margin="2,6,0,0"/></StackPanel>
        </Border>
        <Border Background="{StaticResource Panel}" CornerRadius="14" Padding="11" Margin="8,0" BorderBrush="{StaticResource Line}" BorderThickness="1">
         <StackPanel><Grid Height="150"><Border CornerRadius="11" Background="#2B2925"><Grid><TextBlock Text="♫" FontSize="54" Foreground="{StaticResource Gold}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Button Style="{StaticResource RoundPlay}" Content="▶" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8"/></Grid></Border></Grid><TextBlock Text="Golden Lines" FontSize="14" FontWeight="SemiBold" Margin="2,10,0,0"/><TextBlock Text="Mira Stone" Foreground="{StaticResource Text2}" FontSize="11" Margin="2,3,0,0"/><TextBlock Text="10 songs · 2025" Foreground="{StaticResource Muted}" FontSize="10" Margin="2,6,0,0"/></StackPanel>
        </Border>
        <Border Background="{StaticResource Panel}" CornerRadius="14" Padding="11" Margin="8,0,0,0" BorderBrush="{StaticResource Line}" BorderThickness="1">
         <StackPanel><Grid Height="150"><Border CornerRadius="11" Background="#25272D"><Grid><TextBlock Text="♫" FontSize="54" Foreground="{StaticResource Gold}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Button Style="{StaticResource RoundPlay}" Content="▶" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8"/></Grid></Border></Grid><TextBlock Text="Open Roads" FontSize="14" FontWeight="SemiBold" Margin="2,10,0,0"/><TextBlock Text="Northbound" Foreground="{StaticResource Text2}" FontSize="11" Margin="2,3,0,0"/><TextBlock Text="8 songs · 2025" Foreground="{StaticResource Muted}" FontSize="10" Margin="2,6,0,0"/></StackPanel>
        </Border>
       </UniformGrid>

       <Grid Margin="0,0,0,18">
        <StackPanel><TextBlock Text="Artists" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Your most played artists" Foreground="{StaticResource Text2}" FontSize="11" Margin="0,4,0,0"/></StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Border Background="{StaticResource Soft}" CornerRadius="14" Padding="10,6"><TextBlock Text="32 artists" Foreground="{StaticResource Text2}" FontSize="10"/></Border></StackPanel>
       </Grid>
       <UniformGrid Columns="4">
        <Border Background="{StaticResource GoldSoft}" CornerRadius="14" Padding="12" Margin="0,0,8,0" BorderBrush="{StaticResource Gold}" BorderThickness="1">
         <StackPanel><Grid Height="112"><Border Width="92" Height="92" CornerRadius="46" Background="#29252B" HorizontalAlignment="Left"><TextBlock Text="NA" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource Gold}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Border Background="{StaticResource Gold}" CornerRadius="18" Width="36" Height="36" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2"><TextBlock Text="▶" Foreground="#15120C" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/></Border></Grid><TextBlock Text="Neon Avenue" FontSize="14" FontWeight="SemiBold" Margin="2,5,0,0"/><TextBlock Text="6 albums · 84 songs" Foreground="{StaticResource Text2}" FontSize="10" Margin="2,3,0,0"/><TextBlock Text="SELECTED" Foreground="{StaticResource Gold}" FontSize="8" FontWeight="SemiBold" Margin="2,6,0,0"/></StackPanel>
        </Border>
        <Border Background="{StaticResource Panel}" CornerRadius="14" Padding="12" Margin="8,0" BorderBrush="{StaticResource Line}" BorderThickness="1">
         <StackPanel><Grid Height="112"><Border Width="92" Height="92" CornerRadius="46" Background="#24272B" HorizontalAlignment="Left"><TextBlock Text="TS" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource Gold}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Border Background="{StaticResource Soft}" CornerRadius="18" Width="36" Height="36" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2"><TextBlock Text="▶" Foreground="{StaticResource Gold}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/></Border></Grid><TextBlock Text="The Satellites" FontSize="14" FontWeight="SemiBold" Margin="2,5,0,0"/><TextBlock Text="4 albums · 42 songs" Foreground="{StaticResource Text2}" FontSize="10" Margin="2,3,0,0"/></StackPanel>
        </Border>
        <Border Background="{StaticResource Panel}" CornerRadius="14" Padding="12" Margin="8,0" BorderBrush="{StaticResource Line}" BorderThickness="1">
         <StackPanel><Grid Height="112"><Border Width="92" Height="92" CornerRadius="46" Background="#2B2925" HorizontalAlignment="Left"><TextBlock Text="MS" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource Gold}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Border Background="{StaticResource Soft}" CornerRadius="18" Width="36" Height="36" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2"><TextBlock Text="▶" Foreground="{StaticResource Gold}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/></Border></Grid><TextBlock Text="Mira Stone" FontSize="14" FontWeight="SemiBold" Margin="2,5,0,0"/><TextBlock Text="7 albums · 61 songs" Foreground="{StaticResource Text2}" FontSize="10" Margin="2,3,0,0"/></StackPanel>
        </Border>
        <Border Background="{StaticResource Panel}" CornerRadius="14" Padding="12" Margin="8,0,0,0" BorderBrush="{StaticResource Line}" BorderThickness="1">
         <StackPanel><Grid Height="112"><Border Width="92" Height="92" CornerRadius="46" Background="#25272D" HorizontalAlignment="Left"><TextBlock Text="NB" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource Gold}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Border Background="{StaticResource Soft}" CornerRadius="18" Width="36" Height="36" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2"><TextBlock Text="▶" Foreground="{StaticResource Gold}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/></Border></Grid><TextBlock Text="Northbound" FontSize="14" FontWeight="SemiBold" Margin="2,5,0,0"/><TextBlock Text="5 albums · 37 songs" Foreground="{StaticResource Text2}" FontSize="10" Margin="2,3,0,0"/></StackPanel>
        </Border>
       </UniformGrid>
      </StackPanel>
     </Border>

     <Border Background="{StaticResource Panel}" CornerRadius="18" Padding="25" Margin="0,0,0,24">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="175"/><ColumnDefinition Width="*"/><ColumnDefinition Width="155"/></Grid.ColumnDefinitions>
       <Border Width="150" Height="150" CornerRadius="14" Background="#29262C">
        <Grid><TextBlock Text="♫" FontSize="62" Foreground="{StaticResource Gold}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
         <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Background="#15161B" CornerRadius="9" Padding="8,5"><TextBlock Text="MUSIQ" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Gold}"/></Border>
        </Grid>
       </Border>
       <StackPanel Grid.Column="1" Margin="20,0" VerticalAlignment="Center">
