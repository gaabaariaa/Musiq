<Window x:Class="Musiq.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Musiq" Width="1440" Height="900" MinWidth="1050" MinHeight="680"
 Background="#0D0E12" Foreground="#F5F5F7" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <SolidColorBrush x:Key="Panel" Color="#15161B"/>
  <SolidColorBrush x:Key="Soft" Color="#1C1D23"/>
  <SolidColorBrush x:Key="Hover" Color="#26272E"/>
  <SolidColorBrush x:Key="Text2" Color="#9B9DA7"/>
  <SolidColorBrush x:Key="Muted" Color="#696B75"/>
  <SolidColorBrush x:Key="Gold" Color="#D7B46A"/>
  <SolidColorBrush x:Key="GoldSoft" Color="#2B2417"/>
  <SolidColorBrush x:Key="Line" Color="#272830"/>
  <Style x:Key="Nav" TargetType="Button">
   <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource Text2}"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
   <Setter Property="Padding" Value="13,10"/><Setter Property="Margin" Value="0,2"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border Background="{TemplateBinding Background}" CornerRadius="9"><ContentPresenter Margin="{TemplateBinding Padding}"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource Hover}"/><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Icon" TargetType="Button">
   <Setter Property="Width" Value="38"/><Setter Property="Height" Value="38"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="Foreground" Value="{StaticResource Text2}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="19"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource Hover}"/><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Chip" TargetType="Button">
   <Setter Property="Background" Value="{StaticResource Soft}"/><Setter Property="Foreground" Value="{StaticResource Text2}"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="14,7"/><Setter Property="Margin" Value="0,0,7,0"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="16"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource Hover}"/><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="RoundPlay" TargetType="Button">
   <Setter Property="Width" Value="40"/><Setter Property="Height" Value="40"/><Setter Property="Background" Value="{StaticResource Gold}"/><Setter Property="Foreground" Value="#15120C"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="20"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#E3C27A"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SurfaceCard" TargetType="Border">
   <Setter Property="Background" Value="{StaticResource Panel}"/>
   <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True">
     <Setter Property="Background" Value="{StaticResource Hover}"/>
     <Setter Property="BorderBrush" Value="{StaticResource Gold}"/>
    </Trigger>
   </Style.Triggers>
  </Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="90"/></Grid.RowDefinitions>
  <Grid.ColumnDefinitions><ColumnDefinition Width="225"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

  <Border Grid.Row="0" Grid.Column="0" Background="#111217" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="18,25">
   <DockPanel>
    <StackPanel>
     <TextBlock Text="MUSIQ" FontSize="24" FontWeight="Bold" Margin="10,0,0,32"/>
     <TextBlock Text="LIBRARY" FontSize="10" Foreground="{StaticResource Muted}" Margin="11,0,0,8"/>
     <Button Style="{StaticResource Nav}" Background="{StaticResource GoldSoft}" Foreground="{StaticResource Gold}">
      <StackPanel Orientation="Horizontal"><TextBlock Text="⌂" Width="30" FontSize="18"/><TextBlock Text="Home"/></StackPanel>
     </Button>
     <Button Style="{StaticResource Nav}"><StackPanel Orientation="Horizontal"><TextBlock Text="♫" Width="30" FontSize="17"/><TextBlock Text="Songs"/></StackPanel></Button>
     <Button Style="{StaticResource Nav}"><StackPanel Orientation="Horizontal"><TextBlock Text="◷" Width="30" FontSize="17"/><TextBlock Text="Recently Played"/></StackPanel></Button>
     <Button Style="{StaticResource Nav}"><StackPanel Orientation="Horizontal"><TextBlock Text="★" Width="30" FontSize="17"/><TextBlock Text="Favorites"/></StackPanel></Button>
     <TextBlock Text="PLAYLISTS" FontSize="10" Foreground="{StaticResource Muted}" Margin="11,28,0,8"/>
     <Button Style="{StaticResource Nav}"><StackPanel Orientation="Horizontal"><TextBlock Text="＋" Width="30" FontSize="17"/><TextBlock Text="New Playlist"/></StackPanel></Button>
     <Button Style="{StaticResource Nav}"><StackPanel Orientation="Horizontal"><TextBlock Text="▣" Width="30"/><TextBlock Text="Favorites Mix"/></StackPanel></Button>
     <Button Style="{StaticResource Nav}"><StackPanel Orientation="Horizontal"><TextBlock Text="▣" Width="30"/><TextBlock Text="Road Trip"/></StackPanel></Button>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom">
     <Separator Background="{StaticResource Line}" Margin="10,0,10,10"/>
     <Button Style="{StaticResource Nav}"><StackPanel Orientation="Horizontal"><TextBlock Text="⚙" Width="30"/><TextBlock Text="Settings"/></StackPanel></Button>
    </StackPanel>
   </DockPanel>
  </Border>

  <Grid Grid.Row="0" Grid.Column="1" Margin="32,25,32,20">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid Grid.Row="0" Margin="0,0,0,20">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="360"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel>
     <TextBlock Text="Good evening" FontSize="28" FontWeight="SemiBold"/>
     <TextBlock Text="Your music, your way." Foreground="{StaticResource Text2}" FontSize="13" Margin="0,4,0,0"/>
    </StackPanel>
    <Border Grid.Column="1" Height="42" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="21" Margin="20,0">
     <Grid><TextBlock Text="⌕" FontSize="20" Foreground="{StaticResource Muted}" Margin="15,0,0,0" VerticalAlignment="Center"/><TextBox Margin="45,0,15,0" Background="Transparent" BorderThickness="0" Foreground="White" VerticalContentAlignment="Center" Text="Search your library"/></Grid>
    </Border>
    <Button Grid.Column="2" Style="{StaticResource Icon}" Content="◉"/>
   </Grid>

   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
    <StackPanel>
     <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="18" Padding="20" Margin="0,0,0,22">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
       <Border Width="160" Height="160" CornerRadius="14" Background="{StaticResource GoldSoft}">
        <Grid>
         <TextBlock Text="♫" FontSize="62" Foreground="{StaticResource Gold}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
         <Border Background="#15161B" CornerRadius="8" Padding="7,4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="9"><TextBlock Text="NOW PLAYING" FontSize="7" FontWeight="Bold" Foreground="{StaticResource Gold}"/></Border>
        </Grid>
       </Border>
       <StackPanel Grid.Column="1" Margin="22,0" VerticalAlignment="Center">
        <TextBlock Text="NOW PLAYING" FontSize="10" Foreground="{StaticResource Gold}" FontWeight="SemiBold"/>
        <TextBlock Text="Midnight Drive" FontSize="26" FontWeight="SemiBold" Margin="0,6,0,0"/>
        <TextBlock Text="Neon Avenue · Night City" Foreground="{StaticResource Text2}" FontSize="12" Margin="0,4,0,0"/>
        <Grid Margin="0,16,0,0">
         <ProgressBar Height="4" Value="42" Maximum="100" Foreground="{StaticResource Gold}" Background="{StaticResource Hover}"/>
         <TextBlock Text="1:42" FontSize="9" Foreground="{StaticResource Text2}" Margin="0,10,0,0"/>
         <TextBlock Text="4:18" FontSize="9" Foreground="{StaticResource Text2}" HorizontalAlignment="Right" Margin="0,10,0,0"/>
        </Grid>
        <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
         <Button Style="{StaticResource Icon}" Content="↶" Margin="0,0,4,0"/>
         <Button Style="{StaticResource Icon}" Content="◀" Margin="0,0,4,0"/>
         <Button Style="{StaticResource RoundPlay}" Content="▶" Width="46" Height="46" Margin="0,0,4,0"/>
         <Button Style="{StaticResource Icon}" Content="▶" Margin="0,0,4,0"/>
         <Button Style="{StaticResource Icon}" Content="↷"/>
        </StackPanel>
       </StackPanel>
       <StackPanel Grid.Column="2" VerticalAlignment="Center">
        <TextBlock Text="QUICK CONTROLS" FontSize="9" Foreground="{StaticResource Muted}" FontWeight="SemiBold"/>
        <Button Style="{StaticResource Nav}" Margin="0,7,0,0"><StackPanel Orientation="Horizontal"><TextBlock Text="♡" Width="26" FontSize="16"/><TextBlock Text="Add to favorites"/></StackPanel></Button>
        <Button Style="{StaticResource Nav}"><StackPanel Orientation="Horizontal"><TextBlock Text="☷" Width="26"/><TextBlock Text="Open queue"/></StackPanel></Button>
        <Button Style="{StaticResource Nav}"><StackPanel Orientation="Horizontal"><TextBlock Text="⌁" Width="26"/><TextBlock Text="Lyrics"/></StackPanel></Button>
       </StackPanel>
      </Grid>
     </Border>

     <Border Background="{StaticResource Panel}" CornerRadius="18" Padding="22" Margin="0,0,0,22">
      <StackPanel>
       <TextBlock Text="SEARCH" FontSize="10" Foreground="{StaticResource Gold}" FontWeight="SemiBold"/>
       <TextBlock Text="Find something to play." FontSize="25" FontWeight="SemiBold" Margin="0,6,0,0"/>
       <Border Height="46" Background="{StaticResource Soft}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="23" Margin="0,16,0,18">
        <Grid><TextBlock Text="⌕" FontSize="21" Foreground="{StaticResource Muted}" Margin="15,0,0,0" VerticalAlignment="Center"/><TextBlock Text="Search songs, albums, artists..." Margin="48,0,15,0" Foreground="{StaticResource Text2}" VerticalAlignment="Center"/></Grid>
       </Border>
       <Grid Margin="0,0,0,4"><TextBlock Text="Recent searches" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="Clear" HorizontalAlignment="Right" Foreground="{StaticResource Text2}" FontSize="11" VerticalAlignment="Center"/></Grid>
       <WrapPanel Margin="0,8,0,18">
        <Button Style="{StaticResource Chip}" Content="Midnight Drive"/>
        <Button Style="{StaticResource Chip}" Content="Neon Avenue"/>
        <Button Style="{StaticResource Chip}" Content="Night City"/>
        <Button Style="{StaticResource Chip}" Content="Mira Stone"/>
       </WrapPanel>
       <Grid Margin="0,0,0,8"><TextBlock Text="Top result" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="1 result" HorizontalAlignment="Right" Foreground="{StaticResource Text2}" FontSize="11"/></Grid>
       <Border Background="{StaticResource GoldSoft}" CornerRadius="12" Padding="10">
        <Grid Height="62">
         <Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <Border Width="52" Height="52" CornerRadius="9" Background="#29252B"><TextBlock Text="♫" FontSize="24" Foreground="{StaticResource Gold}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
         <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center"><TextBlock Text="Midnight Drive" FontWeight="SemiBold"/><TextBlock Text="Song · Neon Avenue · Night City" Foreground="{StaticResource Text2}" FontSize="11" Margin="0,4,0,0"/></StackPanel>
         <Button Grid.Column="2" Style="{StaticResource RoundPlay}" Content="▶"/>
        </Grid>
       </Border>
      </StackPanel>
     </Border>

     <Grid Margin="0,0,0,16">
      <TextBlock Text="Search results" FontSize="20" FontWeight="SemiBold"/>
      <TextBlock Text="For “night”" HorizontalAlignment="Right" Foreground="{StaticResource Text2}" FontSize="11" VerticalAlignment="Center"/>
     </Grid>
     <Grid Margin="0,0,0,22">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,8,0">
       <TextBlock Text="Songs" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
       <Border Style="{StaticResource SurfaceCard}" CornerRadius="12" Padding="11" Margin="0,0,0,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions><Border Width="38" Height="38" CornerRadius="7" Background="{StaticResource GoldSoft}"><TextBlock Text="♫" Foreground="{StaticResource Gold}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="Midnight Drive" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="Neon Avenue" FontSize="10" Foreground="{StaticResource Text2}"/></StackPanel><TextBlock Grid.Column="2" Text="4:18" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></Grid></Border>
       <Border Style="{StaticResource SurfaceCard}" CornerRadius="12" Padding="11"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions><Border Width="38" Height="38" CornerRadius="7" Background="#24272B"><TextBlock Text="♫" Foreground="{StaticResource Gold}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="Blue Hour" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="Neon Avenue" FontSize="10" Foreground="{StaticResource Text2}"/></StackPanel><TextBlock Grid.Column="2" Text="3:58" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></Grid></Border>
      </StackPanel>
      <StackPanel Grid.Column="1" Margin="8,0,0,0">
       <TextBlock Text="Albums &amp; artists" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
       <Border Style="{StaticResource SurfaceCard}" CornerRadius="12" Padding="11" Margin="0,0,0,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="42" Height="42" CornerRadius="9" Background="{StaticResource GoldSoft}"><TextBlock Text="▦" FontSize="20" Foreground="{StaticResource Gold}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center"><TextBlock Text="Night City" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="Album · Neon Avenue · 2026" FontSize="10" Foreground="{StaticResource Text2}"/></StackPanel></Grid></Border>
       <Border Style="{StaticResource SurfaceCard}" CornerRadius="12" Padding="11"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="42" Height="42" CornerRadius="21" Background="#25272D"><TextBlock Text="♟" FontSize="20" Foreground="{StaticResource Gold}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center"><TextBlock Text="Neon Avenue" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="Artist · 6 albums · 84 songs" FontSize="10" Foreground="{StaticResource Text2}"/></StackPanel></Grid></Border>
      </StackPanel>
     </Grid>

     <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
      <Button Style="{StaticResource Chip}" Background="{StaticResource GoldSoft}" Foreground="{StaticResource Gold}" Content="All music"/>
      <Button Style="{StaticResource Chip}" Content="Albums"/>
      <Button Style="{StaticResource Chip}" Content="Artists"/>
      <Button Style="{StaticResource Chip}" Content="Genres"/>
      <Button Style="{StaticResource Chip}" Content="Playlists"/>
     </StackPanel>

     <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,22">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="LIBRARY" FontSize="10" Foreground="{StaticResource Gold}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/>
        <Button Style="{StaticResource Chip}" Background="{StaticResource GoldSoft}" Foreground="{StaticResource Gold}" Content="All"/>
        <Button Style="{StaticResource Chip}" Content="Songs"/>
        <Button Style="{StaticResource Chip}" Content="Albums"/>
        <Button Style="{StaticResource Chip}" Content="Artists"/>
        <Button Style="{StaticResource Chip}" Content="Favorites"/>
       </StackPanel>
       <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Border Background="{StaticResource Soft}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="11,7" Margin="0,0,8,0">
         <StackPanel Orientation="Horizontal"><TextBlock Text="↕" Foreground="{StaticResource Muted}" Margin="0,0,7,0"/><TextBlock Text="Recently added" Foreground="{StaticResource Text2}" FontSize="11"/></StackPanel>
        </Border>
        <Border Background="{StaticResource Soft}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="10,7">
         <StackPanel Orientation="Horizontal"><TextBlock Text="▦" Foreground="{StaticResource Gold}" Margin="0,0,7,0"/><TextBlock Text="Comfortable" Foreground="{StaticResource Text2}" FontSize="11"/></StackPanel>
        </Border>
       </StackPanel>
      </Grid>
     </Border>

     <Border Background="{StaticResource Panel}" CornerRadius="16" Padding="18" Margin="0,0,0,20">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel>
        <TextBlock Text="LIBRARY OVERVIEW" FontSize="10" Foreground="{StaticResource Gold}" FontWeight="SemiBold"/>
        <TextBlock Text="Everything in one place." FontSize="21" FontWeight="SemiBold" Margin="0,5,0,0"/>
        <TextBlock Text="Your collection is organized and ready to explore." Foreground="{StaticResource Text2}" FontSize="11" Margin="0,4,0,0"/>
       </StackPanel>
       <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Border Background="{StaticResource Soft}" CornerRadius="12" Padding="14,9" Margin="0,0,7,0">
         <StackPanel><TextBlock Text="1,284" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Songs" FontSize="9" Foreground="{StaticResource Text2}"/></StackPanel>
        </Border>
        <Border Background="{StaticResource Soft}" CornerRadius="12" Padding="14,9" Margin="0,0,7,0">
         <StackPanel><TextBlock Text="128" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Albums" FontSize="9" Foreground="{StaticResource Text2}"/></StackPanel>
        </Border>
        <Border Background="{StaticResource GoldSoft}" CornerRadius="12" Padding="14,9">
         <StackPanel><TextBlock Text="64" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Gold}"/><TextBlock Text="Artists" FontSize="9" Foreground="{StaticResource Text2}"/></StackPanel>
        </Border>
       </StackPanel>
      </Grid>
     </Border>

     <Grid Margin="0,0,0,22">
      <Grid Margin="0,0,0,14">
       <StackPanel><TextBlock Text="DISCOVER" FontSize="10" Foreground="{StaticResource Gold}" FontWeight="SemiBold"/><TextBlock Text="Artists and albums" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
       <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"><Button Style="{StaticResource Chip}" Background="{StaticResource GoldSoft}" Foreground="{StaticResource Gold}" Content="All"/><Button Style="{StaticResource Chip}" Content="Artists"/><Button Style="{StaticResource Chip}" Content="Albums"/></StackPanel>
      </Grid>
      <UniformGrid Columns="4">
       <Border Style="{StaticResource SurfaceCard}" CornerRadius="14" Padding="12" Margin="0,0,7,0"><StackPanel><Grid Height="135"><Border CornerRadius="11" Background="{StaticResource GoldSoft}"><TextBlock Text="♟" FontSize="52" Foreground="{StaticResource Gold}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Border Background="{StaticResource Gold}" CornerRadius="17" Width="34" Height="34" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8"><TextBlock Text="▶" Foreground="#15120C" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/></Border></Grid><TextBlock Text="Neon Avenue" FontWeight="SemiBold" Margin="2,9,0,0"/><TextBlock Text="6 albums · 84 songs" Foreground="{StaticResource Text2}" FontSize="11" Margin="2,3,0,0"/></StackPanel></Border>
       <Border Style="{StaticResource SurfaceCard}" CornerRadius="14" Padding="12" Margin="7,0"><StackPanel><Grid Height="135"><Border CornerRadius="11" Background="#25272D"><TextBlock Text="♟" FontSize="52" Foreground="{StaticResource Gold}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Border Background="{StaticResource Gold}" CornerRadius="17" Width="34" Height="34" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8"><TextBlock Text="▶" Foreground="#15120C" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/></Border></Grid><TextBlock Text="Mira Stone" FontWeight="SemiBold" Margin="2,9,0,0"/><TextBlock Text="7 albums · 61 songs" Foreground="{StaticResource Text2}" FontSize="11" Margin="2,3,0,0"/></StackPanel></Border>
       <Border Style="{StaticResource SurfaceCard}" CornerRadius="14" Padding="12" Margin="7,0"><StackPanel><Grid Height="135"><Border CornerRadius="11" Background="#29252B"><TextBlock Text="▦" FontSize="52" Foreground="{StaticResource Gold}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Border Background="{StaticResource Gold}" CornerRadius="17" Width="34" Height="34" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8"><TextBlock Text="▶" Foreground="#15120C" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/></Border></Grid><TextBlock Text="Night City" FontWeight="SemiBold" Margin="2,9,0,0"/><TextBlock Text="Neon Avenue · 12 songs" Foreground="{StaticResource Text2}" FontSize="11" Margin="2,3,0,0"/></StackPanel></Border>
       <Border Style="{StaticResource SurfaceCard}" CornerRadius="14" Padding="12" Margin="7,0,0,0"><StackPanel><Grid Height="135"><Border CornerRadius="11" Background="#24272B"><TextBlock Text="▦" FontSize="52" Foreground="{StaticResource Gold}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Border Background="{StaticResource Gold}" CornerRadius="17" Width="34" Height="34" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8"><TextBlock Text="▶" Foreground="#15120C" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/></Border></Grid><TextBlock Text="Golden Lines" FontWeight="SemiBold" Margin="2,9,0,0"/><TextBlock Text="Mira Stone · 10 songs" Foreground="{StaticResource Text2}" FontSize="11" Margin="2,3,0,0"/></StackPanel></Border>
      </UniformGrid>
     </Grid>

     <Border Background="{StaticResource Panel}" CornerRadius="18" Padding="22" Margin="0,0,0,22">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="175"/><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
       <Border Width="150" Height="150" CornerRadius="14" Background="{StaticResource GoldSoft}"><Grid><TextBlock Text="♟" FontSize="65" Foreground="{StaticResource Gold}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Border Background="#15161B" CornerRadius="8" Padding="7,4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10"><TextBlock Text="ARTIST" FontSize="8" FontWeight="Bold" Foreground="{StaticResource Gold}"/></Border></Grid></Border>
       <StackPanel Grid.Column="1" Margin="20,0" VerticalAlignment="Center"><TextBlock Text="ARTIST PROFILE" FontSize="10" Foreground="{StaticResource Gold}" FontWeight="SemiBold"/><TextBlock Text="Neon Avenue" FontSize="29" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="Electronic · 6 albums · 84 songs" Foreground="{StaticResource Text2}" FontSize="12" Margin="0,5,0,0"/><StackPanel Orientation="Horizontal" Margin="0,14,0,0"><Button Style="{StaticResource RoundPlay}" Content="▶" Margin="0,0,8,0"/><Button Style="{StaticResource Chip}" Content="Shuffle"/><Button Style="{StaticResource Chip}" Content="♡"/></StackPanel></StackPanel>
       <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="TOP SONG" FontSize="9" Foreground="{StaticResource Muted}"/><TextBlock Text="Midnight Drive" FontSize="15" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="4:18 · Night City" FontSize="10" Foreground="{StaticResource Text2}" Margin="0,4,0,0"/></StackPanel>
      </Grid>
     </Border>
     <Grid Margin="0,0,0,22">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
